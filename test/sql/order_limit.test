# ORDER BY, LIMIT / OFFSET and DISTINCT

statement ok
CREATE TABLE p (id INTEGER PRIMARY KEY, name VARCHAR(10), city VARCHAR(10), age INTEGER)

statement ok
INSERT INTO p VALUES (1, 'ann', 'oslo', 30), (2, 'bo', 'rome', NULL), (3, 'cy', 'oslo', 25), (4, 'di', 'lima', 41), (5, 'ed', 'rome', 25)

# NULL sorts first ascending, last descending; ties keep input order
query nosort
SELECT id FROM p ORDER BY age
----
2
3
5
1
4

query nosort
SELECT id FROM p ORDER BY age DESC, name DESC
----
4
1
5
3
2

query nosort
SELECT name, age * -1 AS neg FROM p WHERE age IS NOT NULL ORDER BY neg LIMIT 2
----
di|-41
ann|-30

query nosort
SELECT id, name FROM p ORDER BY 2 DESC LIMIT 2 OFFSET 1
----
4|di
3|cy

# Columns that are not selected can still order the rows
query nosort
SELECT age FROM p WHERE age > 20 ORDER BY name DESC
----
25
41
25
30

query nosort
SELECT DISTINCT city FROM p ORDER BY city
----
lima
oslo
rome

query nosort
SELECT DISTINCT age FROM p ORDER BY age
----
NULL
25
30
41

# SQLite accepts this; the order is not defined by the DISTINCT rows
statement error must appear in the select list
SELECT DISTINCT city FROM p ORDER BY age

statement error ORDER BY position 3 is out of range
SELECT id, name FROM p ORDER BY 3

query nosort
SELECT id FROM p ORDER BY id LIMIT 0
----
