# Tables, rows, constraints and NULL semantics. Checked against SQLite 3.45;
# where this engine is stricter (VARCHAR(n) lengths, types) or prints
# differently (BOOLEAN as true/false, not 1/0) the result is its own.

statement ok
CREATE TABLE people (id INTEGER PRIMARY KEY, name VARCHAR(10) NOT NULL, city VARCHAR(10), age INTEGER DEFAULT 18)

statement ok
INSERT INTO people VALUES (1, 'ann', 'oslo', 30), (2, 'bo', 'rome', NULL), (3, 'cy', NULL, 25)

statement ok
INSERT INTO people (id, name) VALUES (4, 'di')

query nosort
SELECT id, name, city, age FROM people ORDER BY id
----
1|ann|oslo|30
2|bo|rome|NULL
3|cy|NULL|25
4|di|NULL|18

statement error UNIQUE constraint failed: people.id
INSERT INTO people VALUES (1, 'dup', NULL, 1)

statement error NOT NULL constraint failed: people.name
INSERT INTO people VALUES (5, NULL, NULL, 1)

statement error Value too long for VARCHAR(10) column people.name
INSERT INTO people VALUES (5, 'abcdefghijk', NULL, 1)

statement error Type mismatch
INSERT INTO people VALUES (5, 'x', NULL, 'old')

statement error Table 'people' already exists
CREATE TABLE people (x INTEGER)

# A comparison with NULL is unknown, so WHERE drops the row
query rowsort
SELECT name FROM people WHERE city <> 'oslo'
----
bo

query rowsort
SELECT name FROM people WHERE city IS NULL OR age > 28
----
ann
cy
di

query nosort
SELECT id, age IS NULL, NOT (age > 20) FROM people ORDER BY id
----
1|false|false
2|true|NULL
3|false|false
4|false|true

statement ok
UPDATE people SET age = age + 1 WHERE city IS NOT NULL

query nosort
SELECT id, age FROM people ORDER BY id
----
1|31
2|NULL
3|25
4|18

statement ok
DELETE FROM people WHERE age < 20 OR age IS NULL

query nosort
SELECT id FROM people ORDER BY id
----
1
3

statement ok
DROP TABLE people

statement error Table not found: people
SELECT * FROM people
