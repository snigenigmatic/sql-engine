# Arithmetic, comparisons, LIKE / IN / BETWEEN and number formatting.
# INTEGER is 32-bit here; FLOAT prints as the shortest round-trip text
# with ".0" for whole numbers. Unlike SQLite, division by zero and INTEGER
# overflow are errors rather than NULL / a wider type.

statement ok
CREATE TABLE t (id INTEGER, x INTEGER, f FLOAT, s VARCHAR(20))

statement ok
INSERT INTO t VALUES (1, 7, 0.1, 'apple'), (2, -3, 2.5, 'banana'), (3, NULL, 1.0, 'cherry'), (4, 10, NULL, NULL)

query nosort
SELECT id, x + 1, x * 2, x / 2, -x FROM t ORDER BY id
----
1|8|14|3|-7
2|-2|-6|-1|3
3|NULL|NULL|NULL|NULL
4|11|20|5|-10

# INTEGER and FLOAT mix to FLOAT
query nosort
SELECT id, x + f, f * 3, f / 4 FROM t ORDER BY id
----
1|7.1|0.30000000000000004|0.025
2|-0.5|7.5|0.625
3|NULL|3.0|0.25
4|NULL|NULL|NULL

statement error Division by zero
SELECT x / 0 FROM t

statement error Integer overflow
SELECT x * 2147483647 FROM t WHERE id = 1

query rowsort
SELECT s FROM t WHERE s LIKE '%an%'
----
banana

query rowsort
SELECT s FROM t WHERE s NOT LIKE 'b%'
----
apple
cherry

query rowsort
SELECT id FROM t WHERE x IN (7, 10, NULL)
----
1
4

# NOT IN with a NULL in the list is never true
query rowsort
SELECT id FROM t WHERE x NOT IN (7, NULL)
----

query rowsort
SELECT id FROM t WHERE x BETWEEN -5 AND 8
----
1
2

query rowsort
SELECT id FROM t WHERE f NOT BETWEEN 0.5 AND 2.0
----
1
2

# Numbers compare by value across INTEGER and FLOAT
query rowsort
SELECT id FROM t WHERE f = 1
----
3

query nosort
SELECT id * 1.5 AS scaled, s AS label FROM t WHERE id <= 2 ORDER BY scaled DESC
----
3.0|banana
1.5|apple
